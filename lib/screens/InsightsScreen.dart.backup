        _buildStatusCard(appearance),
        const SizedBox(height: 18),
        
        // Profile Metrics Section
        _buildSectionTitle('Profile Metrics', appearance),
        const SizedBox(height: 12),
        Row(
          children: [
            Expanded(
              child: _buildMetricCard(
                '145',
                'Profile Views',
                Icons.visibility,
                Colors.blue,
                appearance,
              ),
            ),
            const SizedBox(width: 12),
            Expanded(
              child: _buildMetricCard(
                '28',
                'Reach Outs',
                Icons.mail_outline,
                Colors.purple,
                appearance,
              ),
            ),
