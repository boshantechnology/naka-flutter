import 'package:flutter/material.dart';
import 'package:naka/config/app_colors.dart';
import 'package:naka/providers/AppearanceProvider.dart';
import 'package:provider/provider.dart';
import 'package:shared_preferences/shared_preferences.dart';

class InsightsScreen extends StatefulWidget {
  const InsightsScreen({super.key});

  @override
  State<InsightsScreen> createState() => _InsightsScreenState();
}

class _InsightsScreenState extends State<InsightsScreen> with TickerProviderStateMixin {
  String? _userRole;
  bool _showOnlyAvailable = false;
  bool _isOnDuty = true; // Worker duty status
  Map<int, bool> _disabledJobPosts = {}; // Track disabled job posts for contractors
  late TabController _tabController;
  
  // Collapsible section states
  Map<String, bool> _expandedSections = {
    'metrics': true,
    'status': true,
    'activity': false,
    'recommendations': true,
    'jobposts': true,
    'applications': false,
  };

  @override
  void initState() {
    super.initState();
    _loadUserRole();
    _tabController = TabController(length: 2, vsync: this);
  }

  @override
  void dispose() {
    _tabController.dispose();
    super.dispose();
  }

  Future<void> _loadUserRole() async {
    final prefs = await SharedPreferences.getInstance();
    setState(() {
      _userRole = prefs.getString('user_role') ?? 'Worker';
    });
  }

  @override
  Widget build(BuildContext context) {
    return Consumer<AppearanceProvider>(
      builder: (context, appearance, _) {
        return Scaffold(
          backgroundColor: appearance.brightness == Brightness.dark
              ? const Color(0xFF1E1E1E)
              : const Color(0xFFF8F9FA),
          appBar: AppBar(
            backgroundColor: appearance.brightness == Brightness.dark
                ? const Color(0xFF2A2A2A)
                : Colors.white,
            elevation: 0,
            centerTitle: true,
            title: Text(
              'Insights',
              style: TextStyle(
                color: appearance.brightness == Brightness.dark
                    ? Colors.white
                    : AppColors.text,
                fontWeight: FontWeight.bold,
                fontSize: 20,
              ),
            ),
            bottom: PreferredSize(
              preferredSize: const Size.fromHeight(60),
              child: _buildTabBar(appearance),
            ),
          ),
          body: TabBarView(
            controller: _tabController,
            children: [
              _userRole == 'Worker'
                  ? _buildWorkerDashboard(appearance)
                  : _buildContractorDashboard(appearance),
              _buildDetailedMetrics(appearance),
            ],
          ),
        );
      },
    );
  }

  Widget _buildTabBar(AppearanceProvider appearance) {
    return Container(
      color: appearance.brightness == Brightness.dark
          ? const Color(0xFF2A2A2A)
          : Colors.white,
      child: TabBar(
        controller: _tabController,
        labelColor: appearance.primaryColor,
        unselectedLabelColor: appearance.brightness == Brightness.dark
            ? Colors.grey[500]
            : Colors.grey[600],
        labelStyle: const TextStyle(
          fontSize: 13,
          fontWeight: FontWeight.w700,
        ),
        unselectedLabelStyle: const TextStyle(
          fontSize: 13,
          fontWeight: FontWeight.w600,
        ),
        indicator: UnderlineTabIndicator(
          borderSide: BorderSide(
            color: appearance.primaryColor,
            width: 3,
          ),
          insets: const EdgeInsets.symmetric(horizontal: 16),
        ),
        tabs: [
          Tab(
            text: _userRole == 'Worker' ? 'My Profile' : 'Job Posts',
          ),
          const Tab(text: 'Metrics'),
        ],
      ),
    );
  }

  Widget _buildWorkerDashboard(AppearanceProvider appearance) {
    return SingleChildScrollView(
      padding: const EdgeInsets.all(16.0),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          _buildHeaderCard(appearance),
          const SizedBox(height: 16),
          
          // Status Section
          _buildCollapsibleSection(
            appearance,
            'status',
            'Current Status',
            Icons.check_circle_outline,
            _buildStatusCard(appearance),
          ),
          const SizedBox(height: 12),
          
          // Recommendations Section
          _buildCollapsibleSection(
            appearance,
            'recommendations',
            'Recommended for You',
            Icons.stars_outlined,
            _buildRecommendationsPreview(appearance),
          ),
          const SizedBox(height: 12),
          
          // Activity Timeline
          _buildCollapsibleSection(
            appearance,
            'activity',
            'Recent Activity',
            Icons.history,
            _buildActivityPreview(appearance),
          ),
          const SizedBox(height: 20),
        ],
      ),
    );
  }

  Widget _buildContractorDashboard(AppearanceProvider appearance) {
    return SingleChildScrollView(
      padding: const EdgeInsets.all(16.0),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          _buildHeaderCard(appearance),
          const SizedBox(height: 16),
          
          // Active Job Posts Section
          _buildCollapsibleSection(
            appearance,
            'jobposts',
            'Active Job Posts',
            Icons.work_outline,
            _buildActiveJobPostsPreview(appearance),
          ),
          const SizedBox(height: 12),
          
          // Applications Section
          _buildCollapsibleSection(
            appearance,
            'applications',
            'Applications Received',
            Icons.inbox_outlined,
            _buildApplicationsPreview(appearance),
          ),
          const SizedBox(height: 20),
        ],
      ),
    );
  }

  Widget _buildCollapsibleSection(
    AppearanceProvider appearance,
    String sectionKey,
    String title,
    IconData icon,
    Widget content,
  ) {
    final isExpanded = _expandedSections[sectionKey] ?? true;

    return Container(
      decoration: BoxDecoration(
        color: appearance.brightness == Brightness.dark
            ? const Color(0xFF2A2A2A)
            : Colors.white,
        borderRadius: BorderRadius.circular(14),
        border: Border.all(
          color: appearance.brightness == Brightness.dark
              ? Colors.grey[800]!
              : Colors.grey[200]!,
          width: 1,
        ),
        boxShadow: [
          BoxShadow(
            color: Colors.black.withOpacity(0.04),
            blurRadius: 8,
            offset: const Offset(0, 2),
          ),
        ],
      ),
      child: Column(
        children: [
          // Header
          GestureDetector(
            onTap: () {
              setState(() {
                _expandedSections[sectionKey] = !(isExpanded);
              });
            },
            child: Container(
              padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 14),
              child: Row(
                children: [
                  Container(
                    padding: const EdgeInsets.all(8),
                    decoration: BoxDecoration(
                      color: appearance.primaryColor.withOpacity(0.15),
                      borderRadius: BorderRadius.circular(10),
                    ),
                    child: Icon(
                      icon,
                      size: 18,
                      color: appearance.primaryColor,
                    ),
                  ),
                  const SizedBox(width: 12),
                  Expanded(
                    child: Text(
                      title,
                      style: TextStyle(
                        fontSize: 14,
                        fontWeight: FontWeight.w700,
                        color: appearance.brightness == Brightness.dark
                            ? Colors.white
                            : Colors.black87,
                      ),
                    ),
                  ),
                  AnimatedRotation(
                    turns: isExpanded ? 0.5 : 0,
                    duration: const Duration(milliseconds: 200),
                    child: Icon(
                      Icons.expand_more,
                      color: appearance.brightness == Brightness.dark
                          ? Colors.grey[500]
                          : Colors.grey[400],
                    ),
                  ),
                ],
              ),
            ),
          ),
          
          // Divider
          Divider(
            color: appearance.brightness == Brightness.dark
                ? Colors.grey[800]
                : Colors.grey[200],
            height: 1,
            thickness: 1,
          ),
          
          // Content
          if (isExpanded)
            Padding(
              padding: const EdgeInsets.all(16),
              child: content,
            ),
        ],
      ),
    );
  }

  Widget _buildDetailedMetrics(AppearanceProvider appearance) {
    return SingleChildScrollView(
      padding: const EdgeInsets.all(16.0),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          _buildSectionTitle('Performance Metrics', appearance),
          const SizedBox(height: 12),
          if (_userRole == 'Worker') ...[
            Row(
              children: [
                Expanded(
                  child: _buildMetricCard(
                    '145',
                    'Profile Views',
                    Icons.visibility,
                    Colors.blue,
                    appearance,
                  ),
                ),
                const SizedBox(width: 12),
                Expanded(
                  child: _buildMetricCard(
                    '28',
                    'Reach Outs',
                    Icons.mail_outline,
                    Colors.purple,
                    appearance,
                  ),
                ),
              ],
            ),
            const SizedBox(height: 12),
            Row(
              children: [
                Expanded(
                  child: _buildMetricCard(
                    '12',
                    'Comments',
                    Icons.comment,
                    Colors.green,
                    appearance,
                  ),
                ),
                const SizedBox(width: 12),
                Expanded(
                  child: _buildMetricCard(
                    '45',
                    'Likes',
                    Icons.favorite,
                    Colors.red,
                    appearance,
                  ),
                ),
              ],
            ),
            const SizedBox(height: 18),
            _buildSectionTitle('Rating & Reviews', appearance),
            const SizedBox(height: 12),
            _buildRatingCard(appearance),
          ] else ...[
            Row(
              children: [
                Expanded(
                  child: _buildMetricCard(
                    '186',
                    'Views',
                    Icons.visibility,
                    Colors.blue,
                    appearance,
                  ),
                ),
                const SizedBox(width: 12),
                Expanded(
                  child: _buildMetricCard(
                    '42',
                    'Likes',
                    Icons.favorite,
                    Colors.red,
                    appearance,
                  ),
                ),
              ],
            ),
            const SizedBox(height: 12),
            Row(
              children: [
                Expanded(
                  child: _buildMetricCard(
                    '18',
                    'Comments',
                    Icons.comment,
                    Colors.green,
                    appearance,
                  ),
                ),
                const SizedBox(width: 12),
                Expanded(
                  child: _buildMetricCard(
                    '9',
                    'Shares',
                    Icons.share,
                    Colors.orange,
                    appearance,
                  ),
                ),
              ],
            ),
          ],
          const SizedBox(height: 20),
        ],
      ),
    );
  }

  Widget _buildRecommendationsPreview(AppearanceProvider appearance) {
    return Column(
      children: [
        _buildRecommendedWorkerCard(
          appearance,
          'Rajesh Kumar',
          'Carpenter',
          '4.8★ (127 reviews)',
          true,
          'Available for work',
          '2 hours ago',
        ),
        const SizedBox(height: 10),
        _buildRecommendedWorkerCard(
          appearance,
          'Arjun Patel',
          'Carpenter',
          '4.9★ (152 reviews)',
          true,
          'Available for work',
          '1 hour ago',
        ),
        const SizedBox(height: 10),
        Center(
          child: TextButton(
            onPressed: () {},
            child: Text(
              'View All Workers',
              style: TextStyle(
                color: appearance.primaryColor,
                fontWeight: FontWeight.w700,
              ),
            ),
          ),
        ),
      ],
    );
