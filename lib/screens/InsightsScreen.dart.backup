  Widget _buildApplicationsPreview(AppearanceProvider appearance) {
    return Column(
      children: [
        _buildApplicationCard(
          appearance,
          'Rajesh Kumar',
          'Carpenter',
          '4.8★ (127 reviews)',
          '2 hours ago',
        ),
        const SizedBox(height: 10),
        _buildApplicationCard(
          appearance,
          'Vikram Singh',
          'Carpenter',
          '4.6★ (95 reviews)',
          '5 hours ago',
